<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.soundnet</groupId>
	<artifactId>sudunarchiver</artifactId>
	<version>0.0.3</version>

	<name>Sud Unarchiver</name>
	<description>Decompress and convert SoundTrap .sud files to wav, plus click and other detection data.</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>

		<javafx.version>24</javafx.version>

		<main.class>org.soundnet.sudunarchiver.AppLauncher</main.class>
		<app.name>Sud Unarchiver</app.name>
		<!--
			Installer version. Kept separate from ${project.version} because
			jpackage will not accept a leading zero in a macOS bundle version.
		-->
		<app.version>1.0.3</app.version>
		<app.vendor>SoundNet</app.vendor>
		<app.copyright>Copyright (c) Jamie Macaulay</app.copyright>
		<!-- Directory assembled below and used as the jpackage input -->
		<app.dir>${project.build.directory}/app</app.dir>
		<installer.dir>${project.build.directory}/installer</installer.dir>
		<!--
			jpackage output type on macOS. DMG gives a finished (unsigned)
			installer; override with -Dmac.package.type=APP_IMAGE to get a bare
			.app that can be signed and notarised before a DMG is built round it.
		-->
		<mac.package.type>DMG</mac.package.type>
	</properties>

	<dependencies>
	
			<!-- https://mvnrepository.com/artifact/org.openjfx/javafx-controls -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
		</dependency>
	
			<!--Icons for GUI -->
		<dependency>
			<groupId>org.kordamp.ikonli</groupId>
			<artifactId>ikonli-javafx</artifactId>
			<version>12.3.1</version>
		</dependency>

		<!--Fluent design icons for GUI -->
		<dependency>
			<groupId>org.kordamp.ikonli</groupId>
			<artifactId>ikonli-fluentui-pack</artifactId>
			<version>12.3.1</version>
		</dependency>

		<!-- https://mvnrepository.com/artifact/org.jfxtras/jmetro
		<dependency>
			<groupId>org.jfxtras</groupId>
			<artifactId>jmetro</artifactId>
			<version>11.6.16</version>
			<exclusions>
				<exclusion>
					<groupId>org.openjfx</groupId>
					<artifactId>javafx-controls</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.openjfx</groupId>
					<artifactId>javafx</artifactId>
				</exclusion>
			</exclusions>
		</dependency> -->
		
		<!-- Update to transit theme -->
		<dependency>
		    <groupId>com.pixelduke</groupId>
		    <artifactId>transit</artifactId>
		    <version>2.0.0</version>
		    <exclusions>
		        <!--
		            FXSkins drags in the JavaFX 11.0.2 win/mac jars, which hold a
		            complete copy of JavaFX 11 plus its native libraries. Left in,
		            they land on the installer class path ahead of JavaFX
		            ${javafx.version} and ship Windows DLLs inside the macOS app.
		        -->
		        <exclusion>
		            <groupId>org.openjfx</groupId>
		            <artifactId>*</artifactId>
		        </exclusion>
		    </exclusions>
		</dependency>

		<!-- Extra controls for JavaFX -->
		<dependency>
			<groupId>org.controlsfx</groupId>
			<artifactId>controlsfx</artifactId>
			<version>11.1.2</version>
		</dependency>

		<!-- X3 decompresison library -->
		<dependency>
			<groupId>org.pamguard</groupId>
			<artifactId>X3</artifactId>
			<version>2.3.2</version>
		</dependency>


		<!-- Validator library -->
		<dependency>
			<groupId>net.synedra</groupId>
			<artifactId>validatorfx</artifactId>
			<version>0.5.1</version>
		</dependency>
		
		
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.0</version>
				<configuration>
					<release>21</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-maven-plugin</artifactId>
				<version>0.0.8</version>
				<executions>
					<execution>
						<!-- Default configuration for running -->
						<!-- Usage: mvn clean javafx:run -->
						<id>default-cli</id>
						<configuration>
							<mainClass>org.soundnet.sudunarchiver.App</mainClass>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Build an executable JAR -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.1.0</version>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>false</addClasspath>
							<classpathPrefix>lib/</classpathPrefix>
							<mainClass>${main.class}</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>


			<plugin>
				<!--
					Fat jar, for anyone running from the command line with their
					own Java. Attached as sudunarchiver-<version>-all.jar so the
					plain jar stays the main artifact and the installers below
					can lay the dependencies out as separate jars.
				-->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.4.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<shadedArtifactAttached>true</shadedArtifactAttached>
					<shadedClassifierName>all</shadedClassifierName>
					<createDependencyReducedPom>false</createDependencyReducedPom>
					<transformers>
						<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
					</transformers>
				</configuration>
			</plugin>

			<!--
				Collect every runtime jar (including the platform specific
				JavaFX jars) into ${app.dir}, which is what jpackage bundles.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.7.1</version>
				<executions>
					<execution>
						<id>collect-dependencies</id>
						<phase>prepare-package</phase>
						<goals><goal>copy-dependencies</goal></goals>
						<configuration>
							<outputDirectory>${app.dir}</outputDirectory>
							<includeScope>runtime</includeScope>
							<overWriteReleases>true</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Drop our own jar next to the dependencies so the input folder has everything -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>stage-app-jar</id>
						<phase>package</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<target>
								<copy file="${project.build.directory}/${project.build.finalName}.jar"
								      todir="${app.dir}"/>
								<mkdir dir="${installer.dir}"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.2.1</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.3.0</version>
				<configuration>
					<!-- <source>8</source>
					<detectJavaApiLink>false</detectJavaApiLink> -->
					<failOnError>false</failOnError>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Installer profiles. jpackage can only build a native installer for
			the platform it runs on, and bundles a Java runtime into it, so the
			user needs no Java installed. Each profile activates on its own OS:

				macOS   :  mvn -Pinstaller-mac     clean verify   ->  target/installer/*.dmg
				Windows :  mvn -Pinstaller-windows clean verify   ->  target\installer\*.msi
		-->
		<profile>
			<id>installer-mac</id>
			<activation>
				<os><family>mac</family></os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<version>1.6.5</version>
						<executions>
							<execution>
								<id>package-dmg</id>
								<phase>verify</phase>
								<goals><goal>jpackage</goal></goals>
							</execution>
						</executions>
						<configuration>
							<name>${app.name}</name>
							<appVersion>${app.version}</appVersion>
							<vendor>${app.vendor}</vendor>
							<copyright>${app.copyright}</copyright>
							<description>${project.description}</description>
							<type>${mac.package.type}</type>
							<input>${app.dir}</input>
							<destination>${installer.dir}</destination>
							<mainJar>${project.build.finalName}.jar</mainJar>
							<mainClass>${main.class}</mainClass>
							<icon>${project.basedir}/../resources/decompressing_whales_icon_mac.icns</icon>
							<javaOptions>
								<javaOption>-Xmx4096m</javaOption>
								<javaOption>-Dapple.awt.application.appearance=system</javaOption>
								<!-- JavaFX loads its native libraries from the class path -->
								<javaOption>--enable-native-access=ALL-UNNAMED</javaOption>
							</javaOptions>
							<macPackageName>${app.name}</macPackageName>
							<macPackageIdentifier>org.soundnet.sudunarchiver</macPackageIdentifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<profile>
			<id>installer-windows</id>
			<activation>
				<os><family>windows</family></os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<version>1.6.5</version>
						<executions>
							<execution>
								<id>package-msi</id>
								<phase>verify</phase>
								<goals><goal>jpackage</goal></goals>
							</execution>
						</executions>
						<configuration>
							<name>${app.name}</name>
							<appVersion>${app.version}</appVersion>
							<vendor>${app.vendor}</vendor>
							<copyright>${app.copyright}</copyright>
							<description>${project.description}</description>
							<type>MSI</type>
							<input>${app.dir}</input>
							<destination>${installer.dir}</destination>
							<mainJar>${project.build.finalName}.jar</mainJar>
							<mainClass>${main.class}</mainClass>
							<icon>${project.basedir}/../resources/decompressing_whales_icon.ico</icon>
							<javaOptions>
								<javaOption>-Xmx4096m</javaOption>
								<!-- JavaFX loads its native libraries from the class path -->
								<javaOption>--enable-native-access=ALL-UNNAMED</javaOption>
							</javaOptions>
							<winShortcut>true</winShortcut>
							<winMenu>true</winMenu>
							<winMenuGroup>SoundNet</winMenuGroup>
							<winDirChooser>true</winDirChooser>
							<winPerUserInstall>true</winPerUserInstall>
							<!-- Stable UUID: keeps upgrades replacing the previous install -->
							<winUpgradeUuid>cfd655f9-9b0a-4f8e-a2d5-a03eea5a691f</winUpgradeUuid>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
